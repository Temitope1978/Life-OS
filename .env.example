# AI Life OS — provider environment template
#
# Copy to `.env` and fill in real values. `.env` and `.env.*` are
# gitignored and must NEVER be committed. These placeholders are
# intentionally empty.
#
# SECURITY MODEL
#   * API keys, OAuth client secrets, tokens, and database
#     credentials are SERVER-SIDE ONLY. They are read from the
#     environment by the server / Supabase Edge Functions and are
#     never hard-coded in source and never sent to the browser.
#   * The browser receives only non-secret configuration (for
#     example a Google client ID) when a real integration is wired.
#   * Nothing in this file is a real secret.

# ------------------------------------------------------------------
# Supabase  (see supabase/.env.example for the full set)
# ------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=

# ------------------------------------------------------------------
# OpenAI — intelligence (classification, extraction, briefing,
# memory) and meeting transcription (Whisper)
# ------------------------------------------------------------------
OPENAI_API_KEY=

# ------------------------------------------------------------------
# Google — Gmail and Google Calendar (OAuth 2.0)
#
# ONE coherent Google authorization covers both services.
#
# NON-SECRET, BROWSER-SAFE configuration (may be sent to the browser):
GOOGLE_CLIENT_ID=
# The OAuth redirect URI. This is NOT guessed — it must be registered
# in Google Cloud Console and point to the hosted deployment's OAuth
# callback (the app's internal callback route is #/oauth/google/callback).
GOOGLE_REDIRECT_URI=
# Google services to enable, comma-separated (default: gmail,calendar).
GOOGLE_SERVICES=gmail,calendar
# Application mode: "demo" (simulated providers) or "live".
LIFEOS_MODE=demo
#
# SERVER-SIDE SECRETS (NEVER send these to the browser, never commit):
GOOGLE_CLIENT_SECRET=
# OAuth tokens are obtained server-side via the authorization-code
# exchange and stored server-side only.
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=
