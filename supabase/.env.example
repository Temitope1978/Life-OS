# AI Life OS — environment template
#
# Copy to `.env` and fill in real values. `.env` is already gitignored and must
# NEVER be committed. These placeholders are intentionally empty.

# Supabase project settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser, never commit.
# The isolation test refuses to use it — that role bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project settings → Database → Connection string (URI, not the pooler)
# The isolation runner connects as the `postgres` role and SET ROLEs to
# `authenticated` per user.
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=
